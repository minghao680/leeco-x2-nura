/*
 * LeEco Le Max 2 (x2 / LEX820)
 *
 * MSM8996 v3 + PMI8996, 5.7" 1440x2560 dual-DSI panel.
 *
 * Board identification values were read from the live device:
 *   /proc/device-tree/qcom,msm-id    = <0xf6 0x30001>
 *   /proc/device-tree/qcom,board-id  = <0x08 0x2e>
 *   /proc/device-tree/qcom,pmic-id   = <0x20009 0x10013 0x00 0x00>
 *
 * NOTE 1: msm8996-v3.0.dtsi pins qcom,msm-id to <246 0x30000>, but this
 * device reports <246 0x30001>. We therefore include plain msm8996.dtsi
 * (the 3.1 revision) and set the correct msm-id ourselves. This matches
 * what oneplus3 does (it also uses 0x30001 via msm8996.dtsi).
 *
 * NOTE 2: Three DTB variants share board-id 0x2e in the stock boot.img
 * (v3+PMI8996, v3+PMI8994, 8996Pro+PMI8996). The device actually boots the
 * v3+PMI8996 one, which is what we model here.
 */

/dts-v1/;

#include "msm8996.dtsi"
#include "pm8994.dtsi"
#include "pmi8994.dtsi"
#include "pmi8996.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

/ {
	model = "LeEco Le Max 2";
	compatible = "leeco,x2", "qcom,msm8996";
	chassis-type = "handset";

	qcom,msm-id = <246 0x30001>;
	qcom,board-id = <0x08 0x2e>;

	aliases {
		serial0 = &blsp2_uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_up_pin_a>;

		key-vol-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm8994_gpios 3 GPIO_ACTIVE_LOW>;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * ramoops: MUST live at 0x91500000 - that is where the stock
		 * 3.18 kernel and TWRP look for console-ramoops on this device
		 * (msm8996-le-common.dtsi: ramoops_region@91500000). Anything
		 * written elsewhere is invisible after rebooting back to
		 * Android/TWRP.
		 *
		 * The sub-buffer sizes MUST match the stock 3.18 kernel's
		 * ramoops module params exactly (console_size=0x40000,
		 * record_size=0x10000, pmsg_size=0x20000, ecc=0) and the
		 * kernel's allocation order (dmesg records first, then
		 * console, then pmsg) so that records written by one kernel
		 * are parseable by the other. In particular console-size
		 * 0x60000 made our records unreadable by 3.18.
		 */
		ramoops@91500000 {
			compatible = "ramoops";
			reg = <0x0 0x91500000 0x0 0x100000>;
			console-size = <0x40000>;
			record-size  = <0x10000>;
			pmsg-size    = <0x20000>;
		};

		/* relocated from 0x91500000, which the stock ramoops uses */
		mba@92000000 {
			reg = <0x0 0x92000000 0x0 0x200000>;
			no-map;
		};
	};
};

/*
 * Upstream msm8996.dtsi reserves 0x91500000 for mba_mem, which collides with
 * the stock ramoops region. Move the MBA out of the way (delete the node and
 * re-add it so the unit address matches its new reg).
 */
/delete-node/ &mba_mem;

/*
 * PM8994 RPM regulators.
 *
 * These labels are NOT inherited from pm8994.dtsi - every msm8996 board
 * declares the rails it actually uses under &rpm_requests. We only define
 * the ones referenced below; the voltage values match the oneplus3 and
 * xiaomi-msm8996 boards, which use an identical UFS supply arrangement.
 */
&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm8994-regulators";

		vreg_s4a_1p8: s4 {
			regulator-name = "vreg_s4a_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		vreg_l2a_1p25: l2 {
			regulator-name = "vreg_l2a_1p25";
			regulator-min-microvolt = <1250000>;
			regulator-max-microvolt = <1250000>;
		};

		vreg_l12a_1p8: l12 {
			regulator-name = "vreg_l12a_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		vreg_l20a_2p95: l20 {
			regulator-name = "vreg_l20a_2p95";
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
		};

		vreg_l25a_1p2: l25 {
			regulator-name = "vreg_l25a_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};

		vreg_l28a_0p925: l28 {
			regulator-name = "vreg_l28a_0p925";
			regulator-min-microvolt = <925000>;
			regulator-max-microvolt = <925000>;
		};
	};
};

/*
 * UFS: Samsung KLUCG4J1CB-B0B1, 6 LUNs.
 * This is the first thing that must work - without rootfs there is no boot.
 * Supply assignment matches oneplus3 / xiaomi-msm8996, which use the same
 * PM8994 rail layout for UFS.
 */
&ufshc {
	status = "okay";

	vcc-supply = <&vreg_l20a_2p95>;
	vccq-supply = <&vreg_l25a_1p2>;
	vccq2-supply = <&vreg_s4a_1p8>;
	vdd-hba-supply = <&vreg_l25a_1p2>;

	vcc-max-microamp = <600000>;
	vccq-max-microamp = <450000>;
	vccq2-max-microamp = <450000>;
};

&ufsphy {
	status = "okay";

	vdda-phy-supply = <&vreg_l28a_0p925>;
	vdda-pll-supply = <&vreg_l12a_1p8>;

	vdda-phy-max-microamp = <89700>;
	vdda-pll-max-microamp = <18300>;
};

/* Volume keys live on PMIC GPIOs */
&pm8994_gpios {
	vol_up_pin_a: vol-up-state {
		pins = "gpio3";
		function = PMIC_GPIO_FUNC_NORMAL;
		bias-pull-up;
		input-enable;
	};
};

&tlmm {
	gpio-reserved-ranges = <0 4>, <81 4>;
};

/*
 * Debug UART - invaluable when the display does not work yet.
 *
 * The x2 console is BLSP2_UART1 (uart8) on gpio4/5 = mainline blsp2_uart2
 * (serial@75b0000), exactly as the vendor pinctrl uart_console_active and
 * lk2nd's uart_dm_init(8, BLSP2_UART1_BASE) both show. blsp1_uart2 is the
 * BT/hs-uart on gpio41-44 - enabling it was wrong.
 */
&blsp2_uart2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&blsp2_uart2_2pins_default>;
	pinctrl-1 = <&blsp2_uart2_2pins_sleep>;
	status = "okay";
};

&pm8994_resin {
	status = "okay";
	linux,code = <KEY_VOLUMEDOWN>;
};

/*
 * Display: Sharp 1440x2560 dual-DSI.
 *
 * Values below come from the vendor kernel device tree
 * (msm8996-le_x2-pvt.dtsi), which is what a retail PVT unit runs:
 *   qcom,platform-reset-gpio = <&tlmm 24 0>
 *   qcom,platform-te-gpio    = <&tlmm 97 0>
 *
 * The panel has no separate enable GPIO on x2 (the vendor dtsi deletes
 * qcom,platform-bklight-en-gpio), so only reset is wired up here.
 */
&mdss {
	status = "okay";
};

&mdss_dsi0 {
	status = "okay";

	vdda-supply = <&vreg_l2a_1p25>;
	vcca-supply = <&vreg_l28a_0p925>;

	panel@0 {
		compatible = "sharp,leeco-x2-panel";
		reg = <0>;

		qcom,dual-dsi-mode;
		qcom,master-dsi;
		qcom,sync-dual-dsi;

		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel0_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				panel1_in: endpoint {
					remote-endpoint = <&mdss_dsi1_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	status = "okay";

	vdda-supply = <&vreg_l2a_1p25>;
};

&mdss_dsi1 {
	status = "okay";

	vdda-supply = <&vreg_l2a_1p25>;
	vcca-supply = <&vreg_l28a_0p925>;
};

&mdss_dsi1_out {
	remote-endpoint = <&panel1_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi1_phy {
	status = "okay";

	vdda-supply = <&vreg_l2a_1p25>;
};
