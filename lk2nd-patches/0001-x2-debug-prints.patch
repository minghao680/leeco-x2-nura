diff --git a/lib/debug/debug.c b/lib/debug/debug.c
index 64ef6f6..5112352 100644
--- a/lib/debug/debug.c
+++ b/lib/debug/debug.c
@@ -29,6 +29,8 @@
 #include <printf.h>
 #include <list.h>
 #include <string.h>
+#include <fastboot.h>
+#include <lk2nd/util/mmu.h>
 #include <arch/ops.h>
 #include <platform.h>
 #include <platform/debug.h>
@@ -83,8 +85,70 @@ void _panic(void *caller, const char *fmt, ...)
 	halt();
 }
 
+/*
+ * x2 debug: mirror all LK console output into the stock kernel's pstore
+ * console-ramoops buffer at 0x915A0000 (console prz of the 1 MiB ramoops
+ * region the vendor 3.18 kernel reads; survives warm resets). This makes
+ * lk2nd's last words readable even when the crash kills the USB session -
+ * read it back by booting lk2nd again and running `fastboot oem log` on a
+ * NEW session (we also re-emit the buffer there), or from Android pstore.
+ * Header: "LKLOG" + write offset, then raw text up to 100 KiB.
+ */
+#define X2_LKLOG_BASE	0x915A0000UL
+#define X2_LKLOG_MAX	(100 * 1024)
+#define X2_LKLOG_MAGIC	0x474F4B4C /* "LKOG" */
+
+static void x2_lklog_char(char c)
+{
+	static bool mapped = false;
+	volatile uint32_t *hdr;
+	volatile char *buf;
+	uint32_t off;
+
+	if (!mapped) {
+		if (!lk2nd_mmu_map_ram_dynamic("x2 lklog", X2_LKLOG_BASE, 0x100000))
+			return;
+		hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+		if (hdr[0] != X2_LKLOG_MAGIC) {
+			hdr[0] = X2_LKLOG_MAGIC;
+			hdr[1] = 0;
+		}
+		mapped = true;
+	}
+
+	hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+	buf = (volatile char *)(X2_LKLOG_BASE + 16);
+	off = hdr[1];
+	if (off >= X2_LKLOG_MAX)
+		return;
+	buf[off++] = c;
+	hdr[1] = off;
+}
+
+static void x2_lklog_write(const char *str, size_t len)
+{
+	while (len--)
+		x2_lklog_char(*str++);
+}
+
+static void cmd_oem_lklog(const char *arg, void *data, unsigned sz)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+	uint32_t off = hdr[1];
+
+	if (hdr[0] != X2_LKLOG_MAGIC || off == 0 || off > X2_LKLOG_MAX) {
+		fastboot_fail("no lklog in ramoops");
+		return;
+	}
+	arch_clean_invalidate_cache_range(X2_LKLOG_BASE, 16 + off);
+	fastboot_stage((void *)(X2_LKLOG_BASE + 16), off);
+}
+FASTBOOT_REGISTER("oem lklog", cmd_oem_lklog);
+
 int _dputs(const char *str)
 {
+	x2_lklog_write(str, strlen(str));
+
 	while(*str != 0) {
 		_dputc(*str++);
 	}
@@ -94,6 +158,7 @@ int _dputs(const char *str)
 
 static int _dprintf_output_func(char c, void *state)
 {
+	x2_lklog_char(c);
 	_dputc(c);
 
 	return INT_MAX;
