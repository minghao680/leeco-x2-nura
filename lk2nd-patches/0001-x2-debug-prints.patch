+void x2_screen_hex(int row, const char *label, unsigned val)
+{
+	char buf[40];
+	int n = 0;
+	const char *p = label;
+
+	while (*p && n < 20)
+		buf[n++] = *p++;
+	buf[n++] = ':';
+	buf[n++] = ' ';
+	{
+		int shift;
+		int started = 0;
+		for (shift = 28; shift >= 0; shift -= 4) {
+			unsigned d = (val >> shift) & 0xf;
+			if (d || started || shift == 0) {
+				buf[n++] = d < 10 ? ('0' + d) : ('a' + d - 10);
+				started = 1;
+			}
+		}
+	}
