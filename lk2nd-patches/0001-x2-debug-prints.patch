+/*
+ * x2 debug: mirror all LK console output into the stock kernel's pstore
+ * console-ramoops buffer at 0x915A0000 (console prz of the 1 MiB ramoops
+ * region the vendor 3.18 kernel reads; survives warm resets). This makes
+ * lk2nd's last words readable even when the crash kills the USB session -
+ * read it back by booting lk2nd again and running `fastboot oem log` on a
+ * NEW session (we also re-emit the buffer there), or from Android pstore.
+ * Header: "LKLOG" + write offset, then raw text up to 100 KiB.
+ */
+#define X2_LKLOG_BASE	0x915A0000UL
+#define X2_LKLOG_MAX	(100 * 1024)
+#define X2_LKLOG_MAGIC	0x474F4B4C /* "LKOG" */
+
+static void x2_lklog_char(char c)
+{
+	static bool mapped = false;
+	volatile uint32_t *hdr;
+	volatile char *buf;
+	uint32_t off;
+
+	if (!mapped) {
+		/* Retry on every call: early dputs() runs before the MMU tables
+		 * exist and lk2nd_mmu_map_ram_dynamic() fails then. Latching a
+		 * failure would leave the whole log empty. */
+		if (!lk2nd_mmu_map_ram_dynamic("x2 lklog", X2_LKLOG_BASE, 0x100000))
+			return;
+
+		hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+		if (hdr[0] != X2_LKLOG_MAGIC) {
+			hdr[0] = X2_LKLOG_MAGIC;
+			hdr[1] = 0;
+		}
+		mapped = true;
+	}
+
+	hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+	buf = (volatile char *)(X2_LKLOG_BASE + 16);
+	off = hdr[1];
+	if (off >= X2_LKLOG_MAX)
+		return;
+	buf[off++] = c;
+	hdr[1] = off;
+}
+
+/*
+ * Raw marker: used AFTER arch_disable_mmu(), when lk2nd_mmu_map_ram_dynamic()
+ * is no longer callable. Identity mapping + caches off means a plain
+ * physical write is safe.
+ */
+void x2_lklog_marker_raw(const char *tag)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+	volatile char *buf = (volatile char *)(X2_LKLOG_BASE + 16);
+	uint32_t off = hdr[1];
+	const char *p;
+
+	if (hdr[0] != X2_LKLOG_MAGIC) {
+		hdr[0] = X2_LKLOG_MAGIC;
+		off = 0;
+	}
+	for (p = tag; *p && off < X2_LKLOG_MAX - 1; p++)
+		buf[off++] = *p;
+	buf[off++] = '|';
+	hdr[1] = off;
+}
+
+void x2_lklog_marker(const char *tag)
+{
+	volatile uint32_t *hdr;
+	uint32_t off, n = 0;
+	const char *p;
+
+	if (!lk2nd_mmu_map_ram_dynamic("x2 lklog", X2_LKLOG_BASE, 0x100000))
+		return;
+	hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+	if (hdr[0] != X2_LKLOG_MAGIC) {
+		hdr[0] = X2_LKLOG_MAGIC;
+		hdr[1] = 0;
+	}
+	off = hdr[1];
+	/* markers survive independently of the text buffer limit */
+	for (p = tag; *p && n < 32; p++, n++) {
+		if (off + 1 >= X2_LKLOG_MAX)
+			break;
+		((volatile char *)(X2_LKLOG_BASE + 16))[off++] = *p;
+	}
+	((volatile char *)(X2_LKLOG_BASE + 16))[off++] = '|';
+	hdr[1] = off;
+	arch_clean_invalidate_cache_range(X2_LKLOG_BASE, 16 + off);
+}
+
+static void x2_lklog_write(const char *str, size_t len)
+{
+	while (len--)
+		x2_lklog_char(*str++);
+}
+
+static void cmd_oem_lklog(const char *arg, void *data, unsigned sz)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)X2_LKLOG_BASE;
+	uint32_t off = hdr[1];
+
+	if (hdr[0] != X2_LKLOG_MAGIC || off == 0 || off > X2_LKLOG_MAX) {
+		fastboot_fail("no lklog in ramoops");
+		return;
+	}
+	arch_clean_invalidate_cache_range(X2_LKLOG_BASE, 16 + off);
+	fastboot_stage((void *)(X2_LKLOG_BASE + 16), off);
+}
+FASTBOOT_REGISTER("oem lklog", cmd_oem_lklog);
+
 int _dputs(const char *str)
 {
+	x2_lklog_write(str, strlen(str));
+
 	while(*str != 0) {
 		_dputc(*str++);
 	}
@@ -94,6 +209,7 @@ int _dputs(const char *str)
 
 static int _dprintf_output_func(char c, void *state)
 {
+	x2_lklog_char(c);
 	_dputc(c);
 
 	return INT_MAX;
@@ -383,3 +499,18 @@ static int cmd_memtest(int argc, const cmd_args *argv)
 
 #endif
  
+
+/* Publish the DDR decision as a fastboot variable for headless debugging. */
+static char x2_ddr_str[48];
+static void x2_ddr_fastboot_register(void)
+{
+	fastboot_publish("x2ddr", x2_ddr_str);
+}
+FASTBOOT_INIT(x2_ddr_fastboot_register);
+
+void x2_ddr_publish(uint64_t size, uint64_t start)
+{
+	snprintf(x2_ddr_str, sizeof(x2_ddr_str), "size=%llx,start=%llx",
+		 (unsigned long long)size, (unsigned long long)start);
+	dprintf(INFO, "x2dbg: %s\n", x2_ddr_str);
+}
